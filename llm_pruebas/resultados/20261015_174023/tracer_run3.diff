+def _normalize_custom_repr(custom_repr):
+    '''Allow passing a single `(condition, action)` pair instead of a tuple of pairs.'''
+    if len(custom_repr) == 2 and not all(
+            isinstance(x, pycompat.collections_abc.Iterable)
+            for x in custom_repr):
+        return (custom_repr,)
+    return custom_repr
+
