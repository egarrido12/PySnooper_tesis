+def _get_source_from_loader(loader, module_name):
+    '''Ask the module's loader for its source; return a list of lines or None.'''
+    if not hasattr(loader, 'get_source'):
+        return None
+    try:
+        source = loader.get_source(module_name)
+    except ImportError:
+        return None
+    if source is None:
+        return None
+    return source.splitlines()
