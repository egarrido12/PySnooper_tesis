+def _get_ipykernel_source(file_name):
+    source = None
+    try:
+        import linecache
+        _, _, source, _ = linecache.cache.get(file_name)
+        source = [line.rstrip() for line in source] # remove '\n' at the end
+    except Exception:
+        pass
+    return source
+
