+def _get_source_from_file_name(file_name):
+    '''Get the source lines based on the kind of file name; None on failure.'''
+    if ipykernel_filename_pattern.match(file_name):
+        return _get_ipykernel_source(file_name)
+
+    ipython_filename_match = ipython_filename_pattern.match(file_name)
+    if ipython_filename_match:
+        entry_number = int(ipython_filename_match.group(1))
+        return _get_ipython_source(entry_number)
+
+    ansible_filename_match = ansible_filename_pattern.match(file_name)
+    if ansible_filename_match:
+        return _get_ansible_source(ansible_filename_match.group(1),
+                                   ansible_filename_match.group(2))
+
+    return _read_source_file(file_name)
+
+
+def _detect_source_encoding(lines):
+    for line in lines[:2]:
+        match = _SOURCE_CODING_PATTERN.search(line)
+        if match:
+            return match.group(1).decode('ascii')
+    return _DEFAULT_SOURCE_ENCODING
+
+
+def _decode_source_lines(lines):
+    encoding = _detect_source_encoding(lines)
+    return [pycompat.text_type(line, encoding, 'replace') for line in lines]
