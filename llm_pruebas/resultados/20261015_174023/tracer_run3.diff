+def _get_ansible_source(archive_path, module_path):
+    try:
+        import zipfile
+        archive_file = zipfile.ZipFile(archive_path, 'r')
+        return archive_file.read(module_path.replace('\\', '/')).splitlines()
+    except Exception:
+        return None
