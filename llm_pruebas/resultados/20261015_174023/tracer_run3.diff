+def _find_function_definition(source, line_no, source_line):
+    '''
+    Starting at `line_no`, skip decorator lines until the `def` line is found.
+
+    If the end of the source is reached without finding it, fall back to the
+    original `line_no` and `source_line`.
+    '''
+    for candidate_line_no in itertools.count(line_no):
+        try:
+            candidate_source_line = source[candidate_line_no - 1]
+        except IndexError:
+            break
+        if candidate_source_line.lstrip().startswith('def'):
+            return candidate_line_no, candidate_source_line
+    return line_no, source_line
+
